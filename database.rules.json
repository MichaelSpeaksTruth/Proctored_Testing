{
  "rules": {
    "personnel_requests": {
      ".read": "auth != null",
      "$emailKey": {
        ".write": "auth != null",
        ".validate": "newData.child('email').val() == auth.token.email"
      }
    },
    "personnel": {
      ".read": "auth != null",
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'"
    },
    "testState": {
      ".read": "auth != null",
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'"
    },
    "proctoringFlags": {
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      "$uid": {
        ".read": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com' || $uid == auth.uid",
        "$testId": {
          "flags": {
            ".write": "$uid == auth.uid"
          }
        },
        "flags": {
          ".write": "$uid == auth.uid"
        }
      }
    },
    "tests": {
      ".read": "auth != null",
      "$testId": {
        ".write": "auth != null",
        "sections": {
          "$sectionIdx": {
            "questions": {
              "$questionIdx": {
                ".validate": "newData.child('authorEmail').val() == auth.token.email || auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'"
              }
            }
          }
        }
      }
    },
    "participants": {
      ".read": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      "$email": {
        ".read": "data.child('email').val() == auth.token.email"
      }
    },
    "submissions": {
      ".read": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      "$testId": {
        "$uid": {
          ".read": "$uid == auth.uid",
          ".write": "$uid == auth.uid"
        }
      }
    },
    "results": {
      ".read": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      ".write": "auth.token.email == 'imanuragkrverma@gmail.com' || auth.token.email == 'ananyakrishnan2102@gmail.com'",
      "$testId": {
        ".read": "root.child('testState').child($testId).child('resultsDeclared').val() == true",
        "$uid": {
          ".read": "$uid == auth.uid"
        }
      }
    },
    "answerKeys": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
