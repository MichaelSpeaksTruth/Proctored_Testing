rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'imanuragkrverma@gmail.com' ||
        request.auth.token.email == 'ananyakrishnan2102@gmail.com'
      );
    }

    function isParticipant() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/participants/$(request.auth.token.email));
    }

    // Tests: admins can write, participants can read when test is active
    match /tests/{testId} {
      allow read: if isParticipant() || isAdmin();
      allow write: if isAdmin();
    }

    // Participants: admins manage, participants can read own doc
    match /participants/{email} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Submissions: student writes own, admin reads all
    match /submissions/{testId}/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Results: admin writes, participant reads own
    match /results/{testId}/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // Answer keys: admin only
    match /answerKeys/{testId} {
      allow read, write: if isAdmin();
    }
  }
}
